# SPDX-License-Identifier: Apache-2.0
menu "Robot Platform Configuration"

    menu "Build Mode"
        config PRODUCTION_BUILD
            bool "Production build"
            default n
            help
                Enable production hardening. Disables development Wi-Fi
                credential fallback, suppresses verbose logging of sensitive
                data, and enables structured logging output.

                WARNING: On real hardware, production builds require secure
                boot keys and NVS encryption keys to be provisioned. Enabling
                this on a device without provisioned keys will prevent boot.

        config STRUCTURED_LOGGING
            bool "Structured logging (logfmt)"
            default n
            help
                Output logs in machine-parseable logfmt format:
                ts=<ms> level=<L> tag=<T> event=<E> key=val ...
                Useful for fleet monitoring and log aggregation.
                Falls through to normal ESP_LOGx when disabled.
    endmenu

    choice ROBOT_SKU
        prompt "Robot SKU variant"
        default ROBOT_SKU_BASIC
        help
            Select the hardware SKU to configure available features.

        config ROBOT_SKU_BASIC
            bool "Basic (Education/Hobby)"
        config ROBOT_SKU_STANDARD
            bool "Standard (Research/Prototyping)"
        config ROBOT_SKU_PRO
            bool "Pro (Commercial)"
        config ROBOT_SKU_INDUSTRIAL
            bool "Industrial (Automation)"
    endchoice

    menu "Motor / Drivetrain"
        config MOTOR_GEAR_RATIO
            int "Gear reduction ratio"
            default 30 if ROBOT_SKU_INDUSTRIAL
            default 90
            help
                Motor gearbox reduction ratio.
                N20 motors (Basic/Standard/Pro): 90
                550 motors (Industrial): 30

        config MOTOR_ENCODER_PPR
            int "Encoder pulses per revolution (before quadrature)"
            default 120 if ROBOT_SKU_INDUSTRIAL
            default 360
            help
                Raw encoder PPR before quadrature decoding (x4).
                N20 Hall encoder: 360 PPR (CPR = 1440)
                550 Hall encoder: 120 PPR (CPR = 480)

        config MOTOR_MAX_RPM
            int "Max output shaft RPM"
            default 200 if ROBOT_SKU_INDUSTRIAL
            default 150
            help
                Maximum RPM at the output shaft (after gearbox).
                N20 1:90 at 6V: ~150 RPM
                550 1:30 at 12V: ~200 RPM

        config MOTOR_PWM_FREQ_HZ
            int "PWM frequency (Hz)"
            default 15000 if ROBOT_SKU_INDUSTRIAL
            default 20000
            help
                Motor driver PWM frequency.
                DRV8833 (Basic/Standard/Pro): 20000 Hz
                BTS7960 (Industrial): 15000 Hz
    endmenu

    menu "Motor PID Tuning"
        config MOTOR_PID_KP
            int "Proportional gain (x100)"
            default 120
            help
                PID Kp * 100. Default 120 = 1.20

        config MOTOR_PID_KI
            int "Integral gain (x100)"
            default 80
            help
                PID Ki * 100. Default 80 = 0.80

        config MOTOR_PID_KD
            int "Derivative gain (x100)"
            default 1
            help
                PID Kd * 100. Default 1 = 0.01
    endmenu

    menu "Communication"
        config WIFI_SSID
            string "Wi-Fi SSID (development fallback)"
            default "robot-platform"
            help
                Compile-time SSID used only when NVS wifi/ssid is empty.
                For deployed robots, provision via NVS at runtime.

        config WIFI_PASSWORD
            string "Wi-Fi Password (development fallback)"
            default ""
            help
                Compile-time password used only when NVS wifi/password is empty.
                For deployed robots, provision via NVS at runtime.

        config MICROROS_UART_BAUD
            int "micro-ROS UART baud rate"
            default 921600

        config CMD_UDP_PORT
            int "Command UDP port"
            default 8888

        config TELEMETRY_UDP_PORT
            int "Telemetry UDP port"
            default 9999
    endmenu

    menu "Safety"
        config ESTOP_ENABLED
            bool "Enable hardware E-stop monitoring"
            default y

        config CMD_VEL_TIMEOUT_MS
            int "cmd_vel timeout (ms)"
            default 500
            help
                Stop motors if no velocity command received within this period.

        config US_SAFETY_DISTANCE_CM
            int "Ultrasonic safety distance (cm)"
            default 5
            help
                Trigger emergency stop when any sensor reads below this distance.
    endmenu

    menu "Battery"
        config BATTERY_CAPACITY_MAH
            int "Battery capacity (mAh)"
            default 6000

        config BATTERY_CELLS
            int "Number of cells in series"
            default 2
    endmenu

endmenu
