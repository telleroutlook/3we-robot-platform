# SPDX-License-Identifier: Apache-2.0
CONFIG_ROBOT_SKU_INDUSTRIAL=y

# 550 Gear Motor 1:30 + BTS7960 driver
CONFIG_MOTOR_GEAR_RATIO=30
CONFIG_MOTOR_ENCODER_PPR=120
CONFIG_MOTOR_MAX_RPM=200
CONFIG_MOTOR_PWM_FREQ_HZ=15000

# Chassis geometry — 500x400mm chassis + 97mm mecanum wheels
CONFIG_CHASSIS_WHEEL_RADIUS_MM_X10=485
CONFIG_CHASSIS_TRACK_WIDTH_MM=320
CONFIG_CHASSIS_WHEELBASE_MM=300
