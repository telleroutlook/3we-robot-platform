# SPDX-License-Identifier: Apache-2.0
# Base defaults shared across all SKUs

# Custom partition table (2MB app partitions for OTA)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Enable ECDHE for forward secrecy in DTLS PSK mode
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# PSK ciphersuites for DTLS control channel
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_PSK_MODES=y

# DTLS support (cookies, handshake timeout)
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_HELLO_VERIFY=y
CONFIG_MBEDTLS_SSL_DTLS_ANTI_REPLAY=y

# Certificate bundle for HTTPS verification (OTA downloads)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTPS server for captive portal (self-signed cert, defense-in-depth)
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# Hardware stack overflow detection (zero performance cost on ESP32-S3)
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
