# SPDX-License-Identifier: Apache-2.0
CONFIG_ROBOT_SKU_STANDARD=y

# N20 Gear Motor 1:50 + DRV8833 driver (400x320 chassis, 65mm wheels)
CONFIG_MOTOR_GEAR_RATIO=50
CONFIG_MOTOR_ENCODER_PPR=360
CONFIG_MOTOR_MAX_RPM=180
CONFIG_MOTOR_PWM_FREQ_HZ=20000

# Chassis geometry (400x320mm)
CONFIG_CHASSIS_WHEEL_RADIUS_MM_X10=325
CONFIG_CHASSIS_TRACK_WIDTH_MM=260
CONFIG_CHASSIS_WHEELBASE_MM=240
