# 3WE Robot Platform — Environment Variables
# Copy this file to .env and fill in values for your environment.

# ============================================================
# Firmware Development
# ============================================================

# Path to ESP-IDF installation
IDF_PATH=/opt/esp/idf

# Target SKU variant: basic | standard | pro | industrial
ROBOT_TARGET_SKU=standard

# Serial port for firmware flashing (auto-detected if empty)
FLASH_PORT=

# ============================================================
# ROS2
# ============================================================

# ROS2 domain ID (isolates DDS traffic between robots on same network)
ROS_DOMAIN_ID=0

# ROS2 middleware implementation
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# micro-ROS agent serial device
MICROROS_AGENT_DEV=/dev/ttyUSB0

# ============================================================
# Web Control
# ============================================================

# Rosbridge WebSocket URL
VITE_ROSBRIDGE_URL=ws://localhost:9090

# ============================================================
# CI/CD Secrets (GitHub Actions — never commit real values)
# ============================================================

# PyPI trusted publisher (OIDC-based, no token needed in modern setup)
# PYPI_TOKEN=

# NPM publish token (if publishing web-control as public package)
# NPM_TOKEN=

# Firmware OTA signing key path (used by release workflow)
# SIGNING_KEY_PATH=keys/ota_signing_key.pem

# ============================================================
# Fleet Management (Optional)
# ============================================================

# MQTT broker for fleet telemetry
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_FLEET_TOPIC_PREFIX=fleet/

# Robot ID (unique per device, defaults to MAC address)
# ROBOT_ID=
