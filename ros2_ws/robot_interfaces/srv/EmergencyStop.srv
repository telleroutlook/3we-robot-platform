# Software emergency stop trigger (one-way activation only)
# Recovery requires physical hardware acknowledgment — cannot be reset via software.
string reason               # Human-readable reason for E-stop
---
bool success
uint8 current_state         # 0=normal, 1=estopped, 2=recovery_pending, 3=relay_fault
string message

uint8 STATE_NORMAL=0
uint8 STATE_ESTOPPED=1
uint8 STATE_RECOVERY=2
uint8 STATE_RELAY_FAULT=3
