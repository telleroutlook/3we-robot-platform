<?xml version="1.0" ?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Office environment for navigation testing.
     15m x 10m floor plan with corridors, rooms, and furniture. -->
<sdf version="1.9">
  <world name="office">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls (15m x 10m, 0.15m thick, 2.5m tall) -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>7.5 10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>7.5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central corridor wall (separates north rooms from south rooms) -->
    <!-- Left section: x=0 to x=4 -->
    <model name="corridor_wall_left">
      <static>true</static>
      <pose>2 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 0.12 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 0.12 2.5</size></box></geometry>
          <material><ambient>0.92 0.91 0.88 1</ambient><diffuse>0.92 0.91 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor wall gap (door at x=4 to x=4.8, width=0.8m) -->

    <!-- Middle section: x=4.8 to x=10 -->
    <model name="corridor_wall_mid">
      <static>true</static>
      <pose>7.4 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.2 0.12 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.2 0.12 2.5</size></box></geometry>
          <material><ambient>0.92 0.91 0.88 1</ambient><diffuse>0.92 0.91 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor wall gap (door at x=10 to x=10.8, width=0.8m) -->

    <!-- Right section: x=10.8 to x=15 -->
    <model name="corridor_wall_right">
      <static>true</static>
      <pose>12.9 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.2 0.12 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.2 0.12 2.5</size></box></geometry>
          <material><ambient>0.92 0.91 0.88 1</ambient><diffuse>0.92 0.91 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room divider: Meeting room wall (south side, x=5) -->
    <model name="room_divider_south">
      <static>true</static>
      <pose>5 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 4.88 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.88 2.5</size></box></geometry>
          <material><ambient>0.92 0.91 0.88 1</ambient><diffuse>0.92 0.91 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room divider: North side office partition (x=8) -->
    <model name="room_divider_north">
      <static>true</static>
      <pose>8 7.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 4.88 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.88 2.5</size></box></geometry>
          <material><ambient>0.92 0.91 0.88 1</ambient><diffuse>0.92 0.91 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Furniture: Desks (1.2m x 0.6m x 0.75m) -->
    <model name="desk_1">
      <static>true</static>
      <pose>2 7.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="desk_2">
      <static>true</static>
      <pose>2 8.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="desk_3">
      <static>true</static>
      <pose>5.5 7.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="desk_4">
      <static>true</static>
      <pose>5.5 8.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Meeting table (south-west room, 2m x 1m) -->
    <model name="meeting_table">
      <static>true</static>
      <pose>2.5 2.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 0.75</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Moveable chairs (dynamic obstacles) -->
    <model name="chair_1">
      <static>false</static>
      <pose>10 7 0.225 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.03</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chair_2">
      <static>false</static>
      <pose>11 7.8 0.225 0 0 -0.2</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.03</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage cabinet (south-east room) -->
    <model name="cabinet">
      <static>true</static>
      <pose>13 2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 1.5 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 1.5 1.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Narrow doorway test: 0.6m passage between two pillars -->
    <model name="narrow_pillar_left">
      <static>true</static>
      <pose>12 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="narrow_pillar_right">
      <static>true</static>
      <pose>12.8 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf (north-east corner, 1.8m tall) -->
    <model name="bookshelf">
      <static>true</static>
      <pose>14 9.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.35 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.35 1.8</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Water cooler (corridor, near south door) -->
    <model name="water_cooler">
      <static>true</static>
      <pose>6 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Potted plant (corridor decoration) -->
    <model name="potted_plant">
      <static>true</static>
      <pose>9 5.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trash bin (near corridor wall) -->
    <model name="trash_bin">
      <static>false</static>
      <pose>4.5 4.6 0.2 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.01</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging dock with AprilTag (against east wall) -->
    <include>
      <uri>model://charging_dock</uri>
      <name>charging_dock_1</name>
      <pose>14.7 3 0 0 0 3.14159</pose>
    </include>

  </world>
</sdf>
