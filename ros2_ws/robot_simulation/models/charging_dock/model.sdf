<?xml version="1.0" ?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- AprilTag charging dock model for docking simulation.
     Represents a wall-mounted charging station with:
     - Pogo pin contact plate (low, centered)
     - AprilTag 36h11 marker (ID 0) for visual servo alignment
     - LED status indicators (green/red)
     Dock dimensions: 0.4m wide x 0.3m deep x 0.5m tall
     AprilTag: 0.16m x 0.16m at center height 0.35m -->
<sdf version="1.9">
  <model name="charging_dock">
    <static>true</static>

    <!-- Dock body -->
    <link name="dock_body">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.4 0.3 0.5</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.4 0.3 0.5</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <!-- AprilTag marker face (front-facing, z=0.35m height) -->
    <link name="apriltag_marker">
      <pose>0 -0.151 0.35 0 0 0</pose>
      <visual name="tag_visual">
        <geometry><box><size>0.16 0.001 0.16</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- AprilTag black border (slightly larger) -->
    <link name="apriltag_border">
      <pose>0 -0.1505 0.35 0 0 0</pose>
      <visual name="border_visual">
        <geometry><box><size>0.20 0.001 0.20</size></box></geometry>
        <material>
          <ambient>0.0 0.0 0.0 1</ambient>
          <diffuse>0.0 0.0 0.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Pogo pin contact plate (bottom front) -->
    <link name="contact_plate">
      <pose>0 -0.14 0.06 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.12 0.02 0.08</size></box></geometry>
      </collision>
      <visual name="contact_visual">
        <geometry><box><size>0.12 0.02 0.08</size></box></geometry>
        <material>
          <ambient>0.8 0.7 0.2 1</ambient>
          <diffuse>0.8 0.7 0.2 1</diffuse>
          <specular>0.9 0.9 0.5 1</specular>
        </material>
      </visual>
    </link>

    <!-- LED indicator left (green) -->
    <link name="led_green">
      <pose>-0.15 -0.151 0.46 0 0 0</pose>
      <visual name="led_visual">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.0 0.8 0.0 1</ambient>
          <diffuse>0.0 1.0 0.0 1</diffuse>
          <emissive>0.0 0.6 0.0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- LED indicator right (red) -->
    <link name="led_red">
      <pose>0.15 -0.151 0.46 0 0 0</pose>
      <visual name="led_visual">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <emissive>0.6 0.0 0.0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Guide rails for alignment -->
    <link name="guide_left">
      <pose>-0.18 -0.10 0.05 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 0.20 0.10</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 0.20 0.10</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="guide_right">
      <pose>0.18 -0.10 0.05 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.02 0.20 0.10</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 0.20 0.10</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Fixed joints to connect all links -->
    <joint name="tag_joint" type="fixed">
      <parent>dock_body</parent>
      <child>apriltag_marker</child>
    </joint>
    <joint name="border_joint" type="fixed">
      <parent>dock_body</parent>
      <child>apriltag_border</child>
    </joint>
    <joint name="contact_joint" type="fixed">
      <parent>dock_body</parent>
      <child>contact_plate</child>
    </joint>
    <joint name="led_green_joint" type="fixed">
      <parent>dock_body</parent>
      <child>led_green</child>
    </joint>
    <joint name="led_red_joint" type="fixed">
      <parent>dock_body</parent>
      <child>led_red</child>
    </joint>
    <joint name="guide_left_joint" type="fixed">
      <parent>dock_body</parent>
      <child>guide_left</child>
    </joint>
    <joint name="guide_right_joint" type="fixed">
      <parent>dock_body</parent>
      <child>guide_right</child>
    </joint>
  </model>
</sdf>
