<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  Gazebo Fortress simulation overlay for the robot platform.
  Extends the base URDF with Gazebo-specific plugins:
    - Planar move plugin for holonomic (mecanum) motion
    - IMU sensor plugin
    - Ultrasonic ray sensor plugins (x4)
    - Material/color gazebo tags
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_platform_gazebo">

  <!-- Include the base robot description -->
  <xacro:include filename="$(find robot_description)/urdf/robot.urdf.xacro"/>

  <!-- ================================================================ -->
  <!-- Gazebo material colors                                           -->
  <!-- ================================================================ -->

  <gazebo reference="base_link">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.25 0.25 0.25 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
    </material>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <material>
      <ambient>0.9 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.4 0.0 1.0</diffuse>
      <specular>0.4 0.2 0.0 1.0</specular>
    </material>
    <mu1>0.8</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <material>
      <ambient>0.9 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.4 0.0 1.0</diffuse>
      <specular>0.4 0.2 0.0 1.0</specular>
    </material>
    <mu1>0.8</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <material>
      <ambient>0.9 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.4 0.0 1.0</diffuse>
      <specular>0.4 0.2 0.0 1.0</specular>
    </material>
    <mu1>0.8</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="rear_right_wheel_link">
    <material>
      <ambient>0.9 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.4 0.0 1.0</diffuse>
      <specular>0.4 0.2 0.0 1.0</specular>
    </material>
    <mu1>0.8</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="payload_mount_link">
    <material>
      <ambient>0.9 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.4 0.0 1.0</diffuse>
      <specular>0.4 0.2 0.0 1.0</specular>
    </material>
  </gazebo>

  <gazebo reference="imu_link">
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="ultrasonic_front_link">
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="ultrasonic_back_link">
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="ultrasonic_left_link">
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="ultrasonic_right_link">
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <!-- ================================================================ -->
  <!-- Planar Move Plugin — Holonomic (Mecanum) drive simulation        -->
  <!-- This provides omnidirectional motion without simulating           -->
  <!-- individual roller physics, suitable for navigation testing.       -->
  <!-- ================================================================ -->

  <gazebo>
    <plugin filename="ignition-gazebo-planar-move-system"
            name="ignition::gazebo::systems::PlanarMove">
      <!-- Subscribe to velocity commands -->
      <command_topic>/model/robot_platform/cmd_vel</command_topic>
      <!-- Publish odometry -->
      <odometry_topic>/model/robot_platform/odometry</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <!-- Publish TF odom -> base_link -->
      <publish_odom_tf>true</publish_odom_tf>
      <publish_odom>true</publish_odom>
      <!-- Update rate -->
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!-- IMU Sensor Plugin                                                -->
  <!-- ================================================================ -->

  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ================================================================ -->
  <!-- Ultrasonic Sensors — Simulated as narrow-FOV ray sensors         -->
  <!-- HC-SR04 equivalent: ~15 degree cone, 0.02-4.0m range             -->
  <!-- ================================================================ -->

  <!-- Front ultrasonic -->
  <gazebo reference="ultrasonic_front_link">
    <sensor name="ultrasonic_front_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>ultrasonic_front</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.1309</min_angle>  <!-- -7.5 degrees -->
            <max_angle>0.1309</max_angle>   <!-- +7.5 degrees -->
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Back ultrasonic -->
  <gazebo reference="ultrasonic_back_link">
    <sensor name="ultrasonic_back_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>ultrasonic_back</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.1309</min_angle>
            <max_angle>0.1309</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Left ultrasonic -->
  <gazebo reference="ultrasonic_left_link">
    <sensor name="ultrasonic_left_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>ultrasonic_left</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.1309</min_angle>
            <max_angle>0.1309</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Right ultrasonic -->
  <gazebo reference="ultrasonic_right_link">
    <sensor name="ultrasonic_right_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>ultrasonic_right</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.1309</min_angle>
            <max_angle>0.1309</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
