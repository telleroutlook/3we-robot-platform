(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "8.0")

  (general
    (thickness 1.6)
    (legacy_teardrops no)
    (comment "SPDX-License-Identifier: CERN-OHL-P-2.0")
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND")
    (2 "In2.Cu" signal "Power")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user "B.Mask")
    (39 "F.Mask" user "F.Mask")
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user "B.Fab")
    (49 "F.Fab" user "F.Fab")
    (50 "User.1" user)
    (51 "User.2" user)
  )

  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "prepreg") (thickness 0.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In1.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 2" (type "core") (thickness 1.065) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In2.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 3" (type "prepreg") (thickness 0.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG")
      (dielectric_constraints no)
    )
    (pad_to_mask_clearance 0.05)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups yes)
      (pdf_back_fp_property_popups yes)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )

  (net_class "Default"
    (clearance 0.2)
    (trace_width 0.25)
    (via_dia 0.6)
    (via_drill 0.3)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
    (diff_pair_width 0.2)
    (diff_pair_gap 0.15)
  )
  (net_class "Power"
    (clearance 0.3)
    (trace_width 2.0)
    (via_dia 0.8)
    (via_drill 0.4)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
  )
  (net_class "Motor"
    (clearance 0.25)
    (trace_width 1.0)
    (via_dia 0.8)
    (via_drill 0.4)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
  )
  (net_class "USB_DP"
    (clearance 0.2)
    (trace_width 0.2)
    (via_dia 0.6)
    (via_drill 0.3)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
    (diff_pair_width 0.2)
    (diff_pair_gap 0.15)
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+5V")
  (net 4 "VBAT")
  (net 5 "VBAT_MOTOR")

  (gr_line (start 3 90) (end 117 90) (layer "Edge.Cuts") (width 0.05))
  (gr_line (start 117 0) (end 3 0) (layer "Edge.Cuts") (width 0.05))
  (gr_line (start 0 3) (end 0 87) (layer "Edge.Cuts") (width 0.05))
  (gr_line (start 120 87) (end 120 3) (layer "Edge.Cuts") (width 0.05))
  (gr_arc (start 3 3) (mid 0.879 0.879) (end 0 3) (layer "Edge.Cuts") (width 0.05))
  (gr_arc (start 120 3) (mid 119.121 0.879) (end 117 0) (layer "Edge.Cuts") (width 0.05))
  (gr_arc (start 117 90) (mid 119.121 89.121) (end 120 87) (layer "Edge.Cuts") (width 0.05))
  (gr_arc (start 0 87) (mid 0.879 89.121) (end 3 90) (layer "Edge.Cuts") (width 0.05))

  (gr_text "SPDX-License-Identifier: CERN-OHL-P-2.0" (at 60 93) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
    (at 5 5)
    (property "Reference" "MH1" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M2.5" (at 0 4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.5 5.5) (drill 2.75)
      (layers "*.Cu" "*.Mask")
      (net 1 "GND")
    )
  )

  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
    (at 115 5)
    (property "Reference" "MH2" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M2.5" (at 0 4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.5 5.5) (drill 2.75)
      (layers "*.Cu" "*.Mask")
      (net 1 "GND")
    )
  )

  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
    (at 5 85)
    (property "Reference" "MH3" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M2.5" (at 0 4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.5 5.5) (drill 2.75)
      (layers "*.Cu" "*.Mask")
      (net 1 "GND")
    )
  )

  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
    (at 115 85)
    (property "Reference" "MH4" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M2.5" (at 0 4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.5 5.5) (drill 2.75)
      (layers "*.Cu" "*.Mask")
      (net 1 "GND")
    )
  )

  (footprint "Connector:PBC-34" (layer "F.Cu")
    (at 60 87)
    (property "Reference" "J1" (at 0 -6) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "PBC-34_Payload_Bus" (at 0 6) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Footprint" "Connector:PBC-34" (at 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
    (pad "1" thru_hole rect (at -20.32 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "GND"))
    (pad "2" thru_hole circle (at -17.78 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4 "VBAT"))
    (pad "3" thru_hole circle (at -15.24 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "+5V"))
    (pad "4" thru_hole circle (at -12.7 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "+3V3"))
    (pad "5" thru_hole circle (at -10.16 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )

  (footprint "Connector:XT30_Male_Vertical" (layer "F.Cu")
    (at 10 10)
    (property "Reference" "J2" (at 0 -5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "XT30_Battery" (at 0 5) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Footprint" "Connector:XT30_Male_Vertical" (at 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
    (pad "1" thru_hole circle (at -2.5 0) (size 3.0 3.0) (drill 2.0) (layers "*.Cu" "*.Mask") (net 4 "VBAT"))
    (pad "2" thru_hole circle (at 2.5 0) (size 3.0 3.0) (drill 2.0) (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )

  (footprint "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" (layer "F.Cu")
    (at 117 45)
    (property "Reference" "J3" (at -5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "USB_C" (at -5 2.5) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Footprint" "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" (at 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
    (pad "A1" smd rect (at 0 -3.25) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "A4" smd rect (at 0 -2.25) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 ""))
    (pad "A5" smd rect (at 0 -0.25) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 ""))
    (pad "B8" smd rect (at 0 0.75) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 ""))
    (pad "A9" smd rect (at 0 1.75) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "VBAT"))
    (pad "A12" smd rect (at 0 3.25) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "S1" thru_hole circle (at 0 -4.32) (size 1.0 1.0) (drill 0.65) (layers "*.Cu" "*.Mask") (net 1 "GND"))
    (pad "S2" thru_hole circle (at 0 4.32) (size 1.0 1.0) (drill 0.65) (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )

  (footprint "RF_Module:ESP32-S3-WROOM-1" (layer "F.Cu")
    (at 60 40)
    (property "Reference" "U1" (at 0 -12) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "ESP32-S3-WROOM-1" (at 0 12) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Footprint" "RF_Module:ESP32-S3-WROOM-1" (at 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
    (pad "GND" smd rect (at 0 0) (size 6.7 6.7) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "1" smd rect (at -9.0 -7.5) (size 1.8 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at -9.0 -6.23) (size 1.8 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
  )

  (zone (net 1) (net_name "GND") (layer "In1.Cu") (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.25)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon
      (pts
        (xy 0 0) (xy 120 0) (xy 120 90) (xy 0 90)
      )
    )
  )

  (rule_area "Antenna_Keepout" (layer "F.Cu")
    (hatch edge 0.5)
    (keepout (tracks not_allowed) (vias not_allowed) (pads not_allowed) (copperpour not_allowed) (footprints allowed))
    (polygon
      (pts
        (xy 50 28) (xy 70 28) (xy 70 38) (xy 50 38)
      )
    )
  )
  (rule_area "Antenna_Keepout_In1" (layer "In1.Cu")
    (hatch edge 0.5)
    (keepout (tracks not_allowed) (vias not_allowed) (pads not_allowed) (copperpour not_allowed) (footprints allowed))
    (polygon
      (pts
        (xy 50 28) (xy 70 28) (xy 70 38) (xy 50 38)
      )
    )
  )
  (rule_area "Antenna_Keepout_In2" (layer "In2.Cu")
    (hatch edge 0.5)
    (keepout (tracks not_allowed) (vias not_allowed) (pads not_allowed) (copperpour not_allowed) (footprints allowed))
    (polygon
